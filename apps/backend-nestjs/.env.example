DATABASE_URL=postgresql://merline:merline@localhost:5432/merline
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d
REDIS_HOST=localhost
REDIS_PORT=6379
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=merline-media-dev
AWS_ENDPOINT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
# Groq: transcription (Whisper) and translation. Server-side only; never
# commit a value.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_TRANSLATION_MODEL=openai/gpt-oss-120b
GROQ_REPORT_MODEL=openai/gpt-oss-120b
# PDF export: path to a Chromium binary (playwright's chromium works).
CHROMIUM_PATH=
# Background jobs run inside the API. JOBS_WORKER=off disables processing
# on an instance. Splitting long recordings needs ffmpeg/ffprobe on PATH.
JOBS_WORKER=on
APP_URL=http://localhost:4000
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
