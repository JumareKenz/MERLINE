// ─── PHASE 2 — QUALITATIVE INTERVIEW PRODUCT ───
//
// Consent is a first-class record, never implied. A Finding cannot be
// approved or published without a Quotation resolving to a real
// TranscriptSegment — enforced here by non-nullable foreign keys (an orphan
// Quotation cannot exist at the database level) and by the approval
// transition in FindingsService, which additionally requires at least one
// Quotation to be present. See CLAUDE.md invariants 6 and 7.

enum ConsentMethod {
  VERBAL
  WRITTEN
  DIGITAL
}

model Participant {
  id             String    @id @default(uuid())
  displayName    String    @map("display_name")
  externalRef    String?   @map("external_ref")
  metadata       Json      @default("{}")
  organizationId String    @map("organization_id")
  projectId      String?   @map("project_id")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  createdBy    User         @relation("ParticipantCreator", fields: [createdById], references: [id])
  consents     Consent[]
  interviews   Interview[]

  @@index([organizationId])
  @@index([projectId])
  @@map("participants")
}

/**
 * A consent record. Scopes are independent: a participant may permit
 * recording without permitting AI analysis, for example. `withdrawnAt` is
 * checked everywhere consent is relied on — withdrawal blocks future
 * processing without deleting the record itself (the record of consent, and
 * of its withdrawal, is retained).
 */
model Consent {
  id                 String        @id @default(uuid())
  version            String
  method             ConsentMethod
  allowRecording     Boolean       @default(false) @map("allow_recording")
  allowTranscription Boolean       @default(false) @map("allow_transcription")
  allowAiAnalysis    Boolean       @default(false) @map("allow_ai_analysis")
  allowQuotation     Boolean       @default(false) @map("allow_quotation")
  allowPublication   Boolean       @default(false) @map("allow_publication")
  grantedAt          DateTime      @default(now()) @map("granted_at")
  expiresAt          DateTime?     @map("expires_at")
  withdrawnAt        DateTime?     @map("withdrawn_at")
  withdrawnById      String?       @map("withdrawn_by_id")
  metadata           Json          @default("{}")
  organizationId     String        @map("organization_id")
  participantId      String        @map("participant_id")
  actorId            String        @map("actor_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  participant  Participant  @relation(fields: [participantId], references: [id])
  actor        User         @relation("ConsentActor", fields: [actorId], references: [id])
  withdrawnBy  User?        @relation("ConsentWithdrawnBy", fields: [withdrawnById], references: [id])
  interviews   Interview[]

  @@index([organizationId])
  @@index([participantId])
  @@map("consents")
}

enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Interview {
  id             String          @id @default(uuid())
  status         InterviewStatus @default(SCHEDULED)
  scheduledAt    DateTime?       @map("scheduled_at")
  startedAt      DateTime?       @map("started_at")
  endedAt        DateTime?       @map("ended_at")
  location       String?
  notes          String?
  /// Language spoken, if known (e.g. "en", "ha"). Passed to transcription
  /// as a hint: Whisper does not reliably detect Hausa on its own.
  language       String?
  /// Interview format: KII, FGD, IDI or OTHER. Defaults to the project's method.
  type           String?
  /// The exact guide version used (kept when the guide is later revised).
  questionSetId  String?         @map("question_set_id")
  organizationId String          @map("organization_id")
  projectId      String?         @map("project_id")
  participantId  String          @map("participant_id")
  // Required: an interview cannot exist without a consent record. Whether a
  // *recording* may be made is a further, narrower check on
  // consent.allowRecording performed by InterviewsService, since consent can
  // be granted before recording is permitted (e.g. observation-only).
  consentId      String          @map("consent_id")
  interviewerId  String          @map("interviewer_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  participant  Participant  @relation(fields: [participantId], references: [id])
  consent      Consent      @relation(fields: [consentId], references: [id])
  interviewer  User         @relation("InterviewInterviewer", fields: [interviewerId], references: [id])
  recordings   Media[]
  transcripts  Transcript[]
  reports      AnalysisReport[]
  questionSet  QuestionSet?    @relation(fields: [questionSetId], references: [id])
  questionLog  InterviewQuestionLog[]

  @@index([organizationId])
  @@index([participantId])
  @@index([consentId])
  @@map("interviews")
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Transcript {
  id                  String            @id @default(uuid())
  status              TranscriptStatus  @default(PENDING)
  provider            String?
  language            String?
  errorMessage        String?           @map("error_message")
  requestedAt         DateTime          @default(now()) @map("requested_at")
  completedAt         DateTime?         @map("completed_at")
  // Groq transcription pipeline. `language` is what the recording was
  // transcribed as; `requestedLanguage` is the hint given (if any), kept
  // separately because with a hint the provider just echoes it back.
  requestedLanguage   String?           @map("requested_language")
  model               String?
  /// Full machine transcript, as returned (segments hold the timing).
  text                String?
  durationMs          Int?              @map("duration_ms")
  processingMs        Int?              @map("processing_ms")
  attempts            Int               @default(0)
  nextAttemptAt       DateTime?         @map("next_attempt_at")
  // Optional machine translation, stored per segment alongside the original.
  translationLanguage String?           @map("translation_language")
  translationStatus   TranscriptStatus? @map("translation_status")
  translationModel    String?           @map("translation_model")
  translationError    String?           @map("translation_error")
  translatedAt        DateTime?         @map("translated_at")
  organizationId      String            @map("organization_id")
  interviewId         String            @map("interview_id")
  mediaId             String            @map("media_id")
  requestedById       String            @map("requested_by_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  interview    Interview           @relation(fields: [interviewId], references: [id])
  media        Media               @relation(fields: [mediaId], references: [id])
  requestedBy  User                @relation("TranscriptRequester", fields: [requestedById], references: [id])
  segments     TranscriptSegment[]
  reports      AnalysisReport[]

  @@index([organizationId])
  @@index([interviewId])
  @@map("transcripts")
}

model TranscriptSegment {
  id             String    @id @default(uuid())
  index          Int
  startMs        Int       @map("start_ms")
  endMs          Int       @map("end_ms")
  speakerLabel   String?   @map("speaker_label")
  /// The machine transcript. Never overwritten: corrections go to editedText.
  text           String
  /// 0–1, from the model's average log-probability. Low values mark
  /// segments worth checking by ear.
  confidence     Float?
  editedText     String?   @map("edited_text")
  editedById     String?   @map("edited_by_id")
  editedAt       DateTime? @map("edited_at")
  translatedText String?   @map("translated_text")
  organizationId String    @map("organization_id")
  transcriptId   String    @map("transcript_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  transcript   Transcript   @relation(fields: [transcriptId], references: [id])
  editedBy     User?        @relation("TranscriptSegmentEditor", fields: [editedById], references: [id])
  quotations   Quotation[]

  @@unique([transcriptId, index])
  @@index([organizationId])
  @@map("transcript_segments")
}

enum FindingStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
  PUBLISHED
}

enum FindingSource {
  HUMAN
  AI
}

model Finding {
  id              String        @id @default(uuid())
  title           String
  interpretation  String
  theme           String?
  status          FindingStatus @default(DRAFT)
  source          FindingSource @default(HUMAN)
  aiProvider      String?       @map("ai_provider")
  aiModel         String?       @map("ai_model")
  aiPromptVersion String?       @map("ai_prompt_version")
  reviewedAt      DateTime?     @map("reviewed_at")
  publishedAt     DateTime?     @map("published_at")
  organizationId  String        @map("organization_id")
  projectId       String?       @map("project_id")
  createdById     String        @map("created_by_id")
  reviewedById    String?       @map("reviewed_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  createdBy    User         @relation("FindingCreator", fields: [createdById], references: [id])
  reviewedBy   User?        @relation("FindingReviewer", fields: [reviewedById], references: [id])
  quotations   Quotation[]

  @@index([organizationId])
  @@map("findings")
}

/**
 * The evidence link. A Quotation cannot be created except by resolving a real
 * TranscriptSegment (non-nullable FK) — there is no code path that stores a
 * quotation as free text disconnected from the transcript it came from.
 */
model Quotation {
  id                  String   @id @default(uuid())
  excerpt             String
  organizationId      String   @map("organization_id")
  findingId           String   @map("finding_id")
  transcriptSegmentId String   @map("transcript_segment_id")
  createdById         String   @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")

  organization      Organization      @relation(fields: [organizationId], references: [id])
  finding           Finding           @relation(fields: [findingId], references: [id])
  transcriptSegment TranscriptSegment @relation(fields: [transcriptSegmentId], references: [id])
  createdBy         User              @relation("QuotationCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([findingId])
  @@map("quotations")
}

// PHASE 2 — background jobs. A database-backed queue processed inside the
// API (see src/jobs). Failed jobs stay in the table, visible and retryable.
enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Job {
  id             String    @id @default(uuid())
  type           String
  status         JobStatus @default(QUEUED)
  payload        Json      @default("{}")
  /// At most one QUEUED/RUNNING job per key (e.g. "transcribe:<id>").
  dedupeKey      String?   @map("dedupe_key")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(6) @map("max_attempts")
  runAt          DateTime  @default(now()) @map("run_at")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by")
  lastError      String?   @map("last_error")
  completedAt    DateTime? @map("completed_at")
  organizationId String    @map("organization_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([status, runAt])
  @@index([organizationId])
  @@index([dedupeKey])
  @@map("jobs")
}

// PHASE 2 — AI-written research reports: one per interview, one for a
// whole project, or a custom brief asked for in plain language. `content`
// is a rendering-neutral document (sections of paragraphs, lists, tables
// and verified quotations) that the web view and the Word, Excel and PDF
// exports all draw from. Not the legacy MERL `reports` table.
enum AnalysisReportScope {
  INTERVIEW
  PROJECT
  CUSTOM
}

model AnalysisReport {
  id             String              @id @default(uuid())
  scope          AnalysisReportScope
  status         TranscriptStatus    @default(PENDING)
  title          String
  /// What was asked for (CUSTOM reports).
  instructions   String?
  language       String              @default("en")
  content        Json?
  model          String?
  promptVersion  String?             @map("prompt_version")
  errorMessage   String?             @map("error_message")
  /// How many interviews the report drew on.
  sourceCount    Int                 @default(0) @map("source_count")
  projectId      String?             @map("project_id")
  interviewId    String?             @map("interview_id")
  transcriptId   String?             @map("transcript_id")
  organizationId String              @map("organization_id")
  requestedById  String              @map("requested_by_id")
  completedAt    DateTime?           @map("completed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  interview    Interview?   @relation(fields: [interviewId], references: [id])
  transcript   Transcript?  @relation(fields: [transcriptId], references: [id])
  requestedBy  User         @relation("AnalysisReportRequester", fields: [requestedById], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([interviewId])
  @@map("analysis_reports")
}

// PHASE 2 — interview guides ("question sets"). Versioned: editing an
// approved guide creates the next version in the same family, and each
// interview keeps the exact version it used. Only APPROVED guides reach
// the field app. Not the legacy MERL questionnaires.
enum QuestionSetStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model QuestionSet {
  id             String            @id @default(uuid())
  /// Shared by every version of the same guide (the first version's id).
  familyId       String            @map("family_id")
  version        Int               @default(1)
  title          String
  description    String?
  /// KII, FGD, IDI or OTHER.
  interviewType  String            @map("interview_type")
  /// Language codes the questions are written in, e.g. ["en", "ha"].
  languages      String[]          @default(["en"])
  status         QuestionSetStatus @default(DRAFT)
  /// Null: available to every project of this interview type.
  projectId      String?           @map("project_id")
  organizationId String            @map("organization_id")
  createdById    String            @map("created_by_id")
  approvedById   String?           @map("approved_by_id")
  approvedAt     DateTime?         @map("approved_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  project      Project?        @relation(fields: [projectId], references: [id])
  createdBy    User            @relation("QuestionSetCreator", fields: [createdById], references: [id])
  approvedBy   User?           @relation("QuestionSetApprover", fields: [approvedById], references: [id])
  questions    GuideQuestion[]
  interviews   Interview[]

  @@unique([familyId, version])
  @@index([organizationId])
  @@index([projectId])
  @@map("question_sets")
}

model GuideQuestion {
  id            String   @id @default(uuid())
  questionSetId String   @map("question_set_id")
  order         Int
  section       String?
  /// Text by language code: {"en": "...", "ha": "..."}.
  text          Json
  /// OPEN, SINGLE, MULTIPLE or SCALE.
  type          String   @default("OPEN")
  /// Answer options for SINGLE/MULTIPLE, each by language code.
  options       Json     @default("[]")
  scaleMin      Int?     @map("scale_min")
  scaleMax      Int?     @map("scale_max")
  /// Probing notes for the interviewer, by language code.
  probes        Json     @default("{}")
  required      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  questionSet QuestionSet            @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  logEntries  InterviewQuestionLog[]

  @@index([questionSetId])
  @@map("guide_questions")
}

/// What happened to each guide question in an interview: asked or skipped,
/// and roughly when in the recording, so transcripts can be aligned.
model InterviewQuestionLog {
  id             String   @id @default(uuid())
  interviewId    String   @map("interview_id")
  questionId     String   @map("question_id")
  /// ASKED or SKIPPED.
  status         String
  /// Position in the recording (ms) when the question was asked, if known.
  atMs           Int?     @map("at_ms")
  /// The field device's recording id (= the upload id on the stored media).
  recordingRef   String?  @map("recording_ref")
  note           String?
  markedAt       DateTime @map("marked_at")
  organizationId String   @map("organization_id")
  recordedById   String   @map("recorded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  interview    Interview     @relation(fields: [interviewId], references: [id])
  question     GuideQuestion @relation(fields: [questionId], references: [id])
  recordedBy   User          @relation("QuestionLogRecorder", fields: [recordedById], references: [id])

  @@unique([interviewId, questionId])
  @@index([organizationId])
  @@map("interview_question_logs")
}
