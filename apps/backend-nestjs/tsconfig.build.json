{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",

    // Both live outside `src`. Including them makes the TypeScript root the
    // package root, so output nests under `dist/src/` and `npm start`
    // (`node dist/main.js`) breaks. `prisma/*` runs via ts-node; `api/*` is
    // compiled by Vercel's own Node builder.
    "prisma",
    "api"
  ]
}
